rules_version = '2';

// Regras de segurança do banco (Firestore).
// Cole este arquivo inteiro em: Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Admin = existe um documento em /admins/{uid}.
    // Esses documentos só podem ser criados por você, no painel do Firebase.
    function ehAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Usuário ativo = tem cadastro e não foi revogado.
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.revogado == false;
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || ehAdmin();

      // A própria pessoa cria o cadastro, sempre como "não revogado".
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'criadoEm', 'revogado'])
        && request.resource.data.revogado == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80;

      // Só o admin muda alguma coisa, e só o campo "revogado".
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revogado'])
        && request.resource.data.revogado is bool;

      allow delete: if false;
    }

    match /videos/{id} {
      allow read: if ativo() || ehAdmin();

      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['titulo', 'descricao', 'youtubeId', 'categoria', 'ordem', 'criadoEm'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 150
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() <= 5000
        && request.resource.data.youtubeId is string
        && request.resource.data.youtubeId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.ordem is int;

      allow delete: if ehAdmin();
    }

    // Qualquer outra coisa fica bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
